# Copy to .env.local and fill in. Never commit .env.local (already gitignored).

# --- Postgres (required) ---
# Any Postgres 14+ instance works. Fastest to provision: neon.com, Supabase, or Vercel Postgres.
DATABASE_URL=

# --- Anthropic (required) ---
# Used to narrate judgment-engine decisions in plain language. Get a key at console.anthropic.com.
# The ALLOW/HOLD/ESCALATE decision itself is deterministic and does not depend on this -- if it's
# unset or the API call fails, decisions still work, they just fall back to the engine's own
# plain-language rationale instead of an LLM-narrated one.
ANTHROPIC_API_KEY=

# --- App secrets (required) ---
# 32-byte key, base64. Encrypts each merchant's Cleanverse API key and wallet private key at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Back this up outside the repo and outside the database -- losing it makes every stored credential
# unrecoverable, and rotating it requires re-entering every merchant's credentials.
APP_ENCRYPTION_KEY=

# Signs session cookies. Generate the same way as APP_ENCRYPTION_KEY.
SESSION_SECRET=

# Bearer secret for the inbound-payment poll cron endpoint (app/api/cron/poll-inbound), if you wire
# one up with your host's scheduler. Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=

# --- Assay Cleanverse sandbox integration (required, server-side only) ---
# Users never enter these values. Rotate immediately if they are ever committed or shared publicly.
CLEANVERSE_API_ID=
CLEANVERSE_API_KEY=
CLEANVERSE_API_BASE_URL=https://uatapi.cleanverse.com/api/cooperate
# Optional override. Defaults to Cleanverse USD on Monad sandbox.
ASSAY_ATOKEN_ADDRESS=0xaC0893567D43C3E7e6e35a72803df05416C1f20D
